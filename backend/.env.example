# Copy to .env and fill in. Never commit the real .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=4000
# Domain of the web app allowed to call this API (default: *)
CORS_ORIGIN=http://localhost:3000
APP_TZ=Asia/Ho_Chi_Minh
# true = hosts can switch their own subscription tier (testing only)
ALLOW_TIER_SELF_SERVE=true

# Optional — feedback delivery (see README "Góp ý → email của bạn")
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=

# Optional — Telegram bot that messages players moved up from the waitlist
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional — email the after-session survey to guests (Resend, verified domain needed)
NOTIFY_FROM_EMAIL=
# SURVEY_SWEEP_DISABLED=true
