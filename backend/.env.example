# Copy to .env and fill in. Never commit the real .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: anon key, used for sign-in / sign-up / forgot password on users' behalf
SUPABASE_ANON_KEY=

PORT=4000
# Domain of the web app allowed to call this API (default: *)
CORS_ORIGIN=http://localhost:3000
APP_TZ=Asia/Ho_Chi_Minh
# true = hosts can switch their own subscription tier for free (testing only).
# false = upgrades are paid by bank transfer and switched on by an admin.
ALLOW_TIER_SELF_SERVE=false
# The app owner(s): access to /owner (stats, hosts, plan payments, audit log). Comma-separated.
OWNER_EMAILS=
# Optional: where plan payments go / monthly prices (defaults in services/billing.js)
# PLAN_BANK_CODE=VCB
# PLAN_BANK_NAME=Vietcombank
# PLAN_BANK_ACCOUNT=
# PLAN_BANK_HOLDER=
# PLAN_PRICE_BASIC=99000
# PLAN_PRICE_STANDARD=199000
# PLAN_PRICE_ADVANCED=349000
# PLAN_PRICE_PRO=599000
# PLAN_PRICE_SOCIAL_MANAGER=89000

# Optional — feedback delivery (see README "Góp ý → email của bạn")
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=


# Optional — email the after-session survey to guests (Resend, verified domain needed)
NOTIFY_FROM_EMAIL=
# SURVEY_SWEEP_DISABLED=true
